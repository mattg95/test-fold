{
  "manifest_version": 3,
  "name": "Github Fold",
  "version": "0.8.30",
  "description": "Keep test descriptions visible and expand their bodies in GitHub pull request diffs.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": [
        "vendor/parser.js",
        "detector.js",
        "policy.js",
        "viewport.js",
        "content.js",
        "file-tags.js"
      ],
      "css": [
        "style.css",
        "file-tags.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Github Fold",
    "default_popup": "popup.html"
  }
}
